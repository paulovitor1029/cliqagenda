PORT=3000
NODE_ENV=development

# Local PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=SUA_SENHA_REAL_DO_POSTGRES
DB_NAME=cliqagenda

# Produção/web: use DATABASE_URL em vez dos campos acima quando o provedor fornecer URL completa.
DATABASE_URL=
DB_SSL=false

WHATSAPP_PROVIDER=none
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=

PUBLIC_BASE_URL=http://localhost:3000
APP_DOMAIN=localhost
# Deixe vazio quando frontend e backend usam o mesmo dominio.
# Para frontend separado, informe as origens permitidas separadas por virgula.
CORS_ORIGIN=

# Backups
BACKUP_DIR=backend/backups

# Imagens
# local = backend/uploads; cloudinary = armazenamento real em nuvem
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cliqagenda

# E-mail de recuperação de senha opcional
RESEND_API_KEY=
PASSWORD_RESET_FROM=CliqAgenda <no-reply@seudominio.com.br>
